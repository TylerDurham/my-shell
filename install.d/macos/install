#!/usr/bin/env bash

SELECT=
ACTION=install
readonly export REPO_ROOT=$(git rev-parse --show-toplevel)
readonly export INSTALL_ROOT="$REPO_ROOT/install.d/macos"
readonly export PREFIX=my
readonly export MY_BIN_DIR="$REPO_ROOT/dotfiles/.local/share/my/bin"
readonly export MY_LIB_DIR="$REPO_ROOT/dotfiles/.local/share/my/lib"

export PATH="$MY_BIN_DIR:$PATH"

# Prime the sudo timestamp up front so the build does not stall on a
# password prompt halfway through.
sudo -v

is-macos() {
  case "$1" in 
    macos) return 0 ;;
    *) return 1 ;;
  esac
}

# ensure we are on macos
OS=$(sys-get-os)
if ! is-macos "$OS"; then
    echo "$OS is not macos! exiting"
    exit 1
fi

check-command() {
    command -v "$1" &>/dev/null && return 0 || return 1
}

check-package() {
    brew list "$1" &>/dev/null && return 0 || return 1
}

# Put Homebrew on PATH (Apple Silicon or Intel prefix).
load-brew() {
    local prefix
    for prefix in /opt/homebrew /usr/local; do
        if [[ -x "$prefix/bin/brew" ]]; then
            eval "$("$prefix/bin/brew" shellenv)"
            return 0
        fi
    done
    return 1
}

# console logging
debug() {
    echo -n "   "; gum log -l debug "$@" 
}


info() {
    gum log -l info "$@"
}

warn() {
    gum log -l warn "$@"
}

error() {
  gum log -l error "$@"
}

fatal() {
  error "$@"
  exit 1
}

indent() { sed "s/^/$(printf '%*s' "${1:-4}" '')/" >&2; }

if ! load-brew; then
    echo "'brew' is used to install packages. installing now..."
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    load-brew || { echo "Homebrew install failed! exiting"; exit 1; }
fi

# macOS ships bash 3.2; the bash libs (and mapfile below) need bash 4+.
# Install Homebrew's bash and re-run this script under it.
if (( BASH_VERSINFO[0] < 4 )); then
    if ! check-package "bash"; then
        echo "'bash' 4+ is required. installing now..."
        brew install --quiet bash
    fi
    exec "$(brew --prefix)/bin/bash" "$0" "$@"
fi

if ! check-command "gum"; then
    echo "'gum' is used for pretty console logging. installing now..."
    brew install --quiet gum
    clear
    info "'gum' installed! that's more like it..."
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--remove) ACTION=uninstall; shift ;;
        -s|--select) SELECT=1; shift ;;
        *) shift ;;
    esac
done

# modules=(
#     brew.sh
#     packages.sh
#     git.sh
#     bash.sh
#     zsh.sh
#     stow.sh
# )
#
if [[ -n "$SELECT" ]]; then 
  # user wishes to select packages
  prompt="Select modules for '$(basename $INSTALL_ROOT)':"
  mapfile -t modules < <(sys-select-items -m "$INSTALL_ROOT/*.sh" -p "$prompt")
else
  mapfile -t modules < <(sys-list-items "$INSTALL_ROOT/*.sh")
fi

# Tear down in reverse order so later modules (e.g. stow) are undone before
# the earlier ones they depend on (e.g. mkdirs).
if [[ "$ACTION" == "uninstall" ]]; then
  for (( i = 0, j = ${#modules[@]} - 1; i < j; i++, j-- )); do
    tmp="${modules[i]}"; modules[i]="${modules[j]}"; modules[j]="$tmp"
  done
fi

for module in "${modules[@]}"; do
    source "$module"

    # Call 'on_init' hook if it exists
    if declare -F "on_init" >/dev/null; then
      on_init
    fi

    hook="on_$ACTION"
    if declare -f "$hook" >/dev/null; then
      $hook 
    else 
      warn "module '$module' does not implement '$hook'()! skipping..."
    fi
    
    # Call 'on_init' hook if it exists
    if declare -F "on_completed" >/dev/null; then
      on_completed
    fi
done
